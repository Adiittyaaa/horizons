# OpenAI API Key for Agent Analysis
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Keys for Checkout
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# (Optional) Custom Chrome/Chromium Executable Path
# Not required locally if `chromium` package is installed.
# Useful in production if using a specific binary.
CHROME_EXECUTABLE_PATH=
